---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main>
        <article class="h-[calc(100vh-2rem)] w-full">
            <section class="h-full flex flex-col items-center p-4 space-y-16">
                <h1 class="text-8xl font-bold">¡Ups!</h1>
                <div class="rounded-container relative flex flex-col items-center justify-center gap-4">
                    <p>Parece que te has salido de los límites del bosque :C</p>
                    <a href="/" class="w-48 bg-[var(--pico-color-2)] text-left p-2">
                        🏡 VOLVER AL INICIO
                    </a>
                </div>
            </section>
        </article>
    </main>
</Layout>