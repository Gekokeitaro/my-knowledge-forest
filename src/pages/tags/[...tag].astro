---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CardList from '../../components/CardList.astro';

export const prerender = false;

const notes = await getCollection('notes');
const { tag } = Astro.params;
const notesFiltered = notes.filter(note => {
  if (tag) {
    return note.data.tags.includes(tag);
  }
  return false;
});
---

<Layout>
  <main class="p-1.5">
    <section class="rounded-container h-[calc(100vh-2rem)] w-full p-4 -mt-1.5">
      <h1 class="container-title">Notas con el tag: {tag}</h1>

      <div class="grid grid-cols-3 gap-4">
        {
        notesFiltered.map(note => (
          <a
            href={`/notes/${note.id}`}
            class="p-4 border-2 rounded-lg hover:bg-[var(--pico-color-2)] transition-colors h-24 content-center"
          >
            <h3 class="font-bold text-balance text-center">{note.data.title}</h3>
          </a>
        ))
      }
    </section>
  </main>
</Layout>
