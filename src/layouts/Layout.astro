---
import { getCollection } from 'astro:content';
import NavMenu from '../components/NavMenu';
import '../styles/global.css';
import RandomNoteButton from '../components/RandomNoteButton';

const noteList = await getCollection('notes');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Mi Knowledge Forest</title>
  </head>
  <body>
      <nav class="pb-4">
        <NavMenu>
          <RandomNoteButton className={'block'} collection={noteList} client:only="react"/>
        </NavMenu>
        <slot name="noteLocalMap" />
      </nav>
      <div>
        <slot />
      </div>
      <aside class="pb-4">
        <slot name="noteOutline" />
      </aside>
  </body>
</html>
