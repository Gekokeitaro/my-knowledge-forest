---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from 'astro:content';
import CardList from '../components/CardList.astro';
import NoteHeader from '../components/NoteHeader.astro';
import RandomNoteButton from '../components/RandomNoteButton';
import Layout from '../layouts/Layout.astro';
import type { NoteHeaderMetadata } from '../types/general.types';

const noteList = await getCollection('notes');

const welcomeNote = (await getEntry(
  'notes',
  'bienvenide-al-bosque-de-conocimientos'
)) as CollectionEntry<'notes'>;
const { title, tags } = welcomeNote.data;

const noteType = tags.find(tag => tag.includes('type'))?.split('/')[1];
const headerMetadata: NoteHeaderMetadata = {
  ...welcomeNote.data,
  type: noteType || 'unknown',
};

const { Content } = await render(welcomeNote);
---

<Layout>
  <main>
    <article class="h-[calc(100vh-2rem)] w-full flex flex-col gap-1">
      <NoteHeader headerMetadata={headerMetadata} />
      <section class="p-4 space-y-4">
        <Content />
        <p class="inline-flex justify-center text-center items-center w-full mx-8 my-2">
            <span>Para explorar, haz click en
            <span class="relative justify-center items-center">
              <span class="bg-[var(--pico-color-2)] text-left p-2">🎲 PERDERSE EN EL BOSQUE</span>
              <span class="absolute left-0">
                <RandomNoteButton
                  client:only="react"
                  collection={noteList}
                />
              </span>
            </span>
            o empieza por mi canon personal con mis temas recurrentes.</span>
          </p>
      </section>
      <section class="flex-1">
          <h2 class="container-title">PERSONAL CANON</h2>
          <p class="text-xl absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
            Próximamente...
          </p>
          <div class="personal-canon blur-2xl pointer-events-none">
            <CardList />
          </div>
      </section>
    </article>
  </main>
</Layout>
