---
import { getCollection } from 'astro:content';
import NavMenu from '../components/NavMenu';
import '../styles/global.css';
import RandomNoteButton from '../components/RandomNoteButton';
import SearchDialog from '../components/search-dialog';

const noteList = await getCollection('notes');

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Mi Knowledge Forest</title>
  </head>
  <body>
      <nav class="pb-4">
        <NavMenu>
          <RandomNoteButton className={'w-full block'} collection={noteList} client:only="react"/>
          <button onclick="document.querySelector('dialog')?.showModal()" class="w-full bg-[var(--pico-color-2)] text-left p-2">
            🔍 BUSCAR
          </button>
        </NavMenu>
        <slot name="noteLocalMap" />
      </nav>
      <SearchDialog collection={noteList} client:only="react"/>
      <div>
        <slot />
      </div>
      <aside class="pb-4">
        <slot name="noteOutline" />
      </aside>
  </body>
</html>
